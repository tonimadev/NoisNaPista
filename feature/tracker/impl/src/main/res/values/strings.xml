    <string name="tracker_status_off_title">Detecção desligada</string>
    <string name="tracker_status_off_body">O app só encontra buracos com a detecção ligada. Ative antes de sair dirigindo.</string>
    <string name="tracker_status_off_needs_location_body">O app só encontra buracos com a detecção ligada. Ao ativar, vamos pedir sua localização para marcar onde cada buraco está.</string>
